# DocuTrack environment variables — copy to .env and fill in.

# --- Database (Neon Postgres) -------------------------------------------------
# Create a free project at https://neon.tech, then copy the connection string.
# DATABASE_URL is the pooled connection (used at runtime).
# DIRECT_URL is the direct connection (used for migrations / db push).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/docutrack?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/docutrack?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Generate a secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"
# Only needed in production if the URL isn't auto-detected:
# AUTH_URL="https://your-app.vercel.app"

# --- App ----------------------------------------------------------------------
# Comma-separated. Students must sign up with one of these email domains.
STUDENT_EMAIL_DOMAIN="mitaoe.ac.in"
# Public base URL, used to build links inside emails.
APP_URL="https://docutrack-zeta.vercel.app"

# --- Email (EmailJS) — OPTIONAL ----------------------------------------------
# Real emails for status notifications and password-reset links. Leave blank to
# disable email (the app still works; reset falls back to an in-page form).
# In the EmailJS dashboard: connect an email service, create two templates, and
# enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
# Template ids. Set only the ones you want active.
#   Notification template vars: to_email, to_name, title, message, link
EMAILJS_TEMPLATE_NOTIFICATION=""
#   Reset template vars: to_email, to_name, reset_link
EMAILJS_TEMPLATE_RESET=""

# --- Ask Help AI assistant (Gemini) — OPTIONAL -------------------------------
# Google Gemini API key. The floating "Ask Help" chatbot is disabled if unset.
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-3.6-flash).
GEMINI_MODEL=""
