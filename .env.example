# DocuTrack environment variables — copy to .env and fill in.

# --- Database (Neon Postgres) -------------------------------------------------
# Create a free project at https://neon.tech, then copy the connection string.
# DATABASE_URL is the pooled connection (used at runtime).
# DIRECT_URL is the direct connection (used for migrations / db push).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/docutrack?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/docutrack?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Generate a secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"
# Only needed in production if the URL isn't auto-detected:
# AUTH_URL="https://your-app.vercel.app"

# --- App ----------------------------------------------------------------------
# Comma-separated. Students must sign up with one of these email domains.
STUDENT_EMAIL_DOMAIN="mitaoe.ac.in"
